+type GreetingBucket = { from: number; to: number; variants: string[] };
+
+const DEFAULT_GREETING_BUCKETS: GreetingBucket[] = [
+  { from: 5, to: 11, variants: ["gm, {name}", "morning, {name}", "gm patriot"] },
+  { from: 11, to: 17, variants: ["afternoon, {name}", "back at it, {name}"] },
+  { from: 17, to: 22, variants: ["evening, {name}", "burning daylight, {name}"] },
+  { from: 22, to: 5, variants: ["night shift, {name}", "still up, {name}?"] },
+];
+
+function greetingName(configured?: unknown): string {
+  const raw = process.env.PI_GREET_NAME || (typeof configured === "string" ? configured : "") || getHomeDir().split("/").pop() || "there";
+  return raw.charAt(0).toUpperCase() + raw.slice(1);
+}
+
+function inBucket(bucket: GreetingBucket, hour: number): boolean {
+  // a bucket may wrap midnight, e.g. 22 -> 5
+  return bucket.from <= bucket.to ? hour >= bucket.from && hour < bucket.to : hour >= bucket.from || hour < bucket.to;
+}
+
+export function resolveGreeting(now: Date = new Date(), pick: (n: number) => number = (n) => Math.floor(Math.random() * n)): string {
+  let buckets = DEFAULT_GREETING_BUCKETS;
+  let name: string | undefined;
+
+  try {
+    const parsed = JSON.parse(readFileSync(getAgentPath("greetings.json"), "utf8")) as {
+      name?: unknown;
+      buckets?: unknown;
+    };
+    if (typeof parsed.name === "string") name = parsed.name;
+    if (Array.isArray(parsed.buckets)) {
+      const valid = (parsed.buckets as GreetingBucket[]).filter(
+        (b) => typeof b?.from === "number" && typeof b?.to === "number" && Array.isArray(b?.variants) && b.variants.length > 0,
+      );
+      if (valid.length > 0) buckets = valid;
+    }
+  } catch {
+    // no file, bad json, or unreadable - the defaults above still greet
+  }
+
+  const bucket = buckets.find((b) => inBucket(b, now.getHours())) ?? buckets[0];
+  const variant = bucket.variants[pick(bucket.variants.length)] ?? bucket.variants[0];
+  return variant.replace(/\{name\}/g, greetingName(name));
+}
+
+let cachedGreeting: string | undefined;
+
+// buildLeftColumn runs on every repaint, so picking per call made the variant
+// flicker as the welcome screen re-rendered - decide once per process
+export function welcomeGreeting(): string {
+  if (cachedGreeting === undefined) cachedGreeting = resolveGreeting();
+  return cachedGreeting;
+}
