{
  "theme": "dark",
  "defaultProvider": "amazon-bedrock",
  "defaultModel": "us.anthropic.claude-sonnet-5",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-messenger",
    "npm:pi-mcp-adapter",
    "npm:pi-observational-memory",
    "npm:@houndmcp/hound-mcp-pi",
    "npm:pi-powerline-footer",
    "npm:pi-terminal-theme",
    "git:github.com/mowenroot/pi-background-bash"
  ],
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "amazon-bedrock/us.anthropic.claude-opus-5": "low"
  },
  "showLastPrompt": false,
  "powerline": {
    "preset": "default",
    "disabledSegments": [
      "cost"
    ]
  },
  "observational-memory": {
    "model": {
      "provider": "amazon-bedrock",
      "id": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      "thinking": "off"
    }
  }
